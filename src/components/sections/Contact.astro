---
// src/components/sections/Contact.astro
import type { CONTENT } from "../../data/portfolioData";
import { AnimatedSection } from "../../components/ui/AnimatedSection.tsx";

interface Props {
  content: (typeof CONTENT)["es"];
}

const { content } = Astro.props;
const CONTACT = content.CONTACT;
const UI = content.UI;

// Clean Costa Rica WhatsApp Link (+506)
const cleanPhone = CONTACT.phone.replace(/[^0-9]/g, "");
const whatsappUrl = `https://wa.me/506${cleanPhone}`;
---

<section id="contacto" class="max-w-4xl mx-auto px-6 py-20 md:py-28">
  <AnimatedSection client:visible>
    <div class="flex flex-col items-center text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/25 text-sky-400 text-xs font-semibold mb-4 backdrop-blur-md">
        ✉️ Contact
      </div>
      <h3 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">
        {UI.contactSectionTitle}
      </h3>
      <p class="text-gray-400 max-w-lg leading-relaxed text-sm md:text-base">
        {UI.contactSubtitle}
      </p>
    </div>
  </AnimatedSection>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
    <!-- Email Card -->
    <AnimatedSection client:visible delay={0.15}>
      <a 
        href={`mailto:${CONTACT.email}`}
        class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col items-center text-center gap-4 group h-full justify-between"
        style="will-change: transform, opacity;"
      >
        <div class="p-3.5 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/15 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-1">Email</h4>
          <p class="text-xs text-gray-400 font-mono select-all truncate max-w-[180px]">{CONTACT.email}</p>
        </div>
        <span class="text-xs font-semibold text-sky-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          {UI.contactButton} &rarr;
        </span>
      </a>
    </AnimatedSection>

    <!-- WhatsApp Card -->
    <AnimatedSection client:visible delay={0.3}>
      <a 
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col items-center text-center gap-4 group h-full justify-between"
        style="will-change: transform, opacity;"
      >
        <div class="p-3.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/15 group-hover:scale-110 transition-transform duration-300">
          <!-- WhatsApp Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.66.986 3.284 1.447 5.35 1.448 5.263 0 9.545-4.28 9.548-9.549.002-2.553-.993-4.955-2.798-6.76C16.896 2.486 14.493 1.49 11.94 1.492c-5.269 0-9.55 4.282-9.553 9.552-.001 2.126.561 3.2 1.555 4.887l-.993 3.626 3.708-.973zM17.487 14.39c-.3-.15-1.782-.88-2.062-.982-.28-.1-.485-.15-.688.15-.203.3-.787.98-.966 1.185-.18.2-.358.224-.658.075-.3-.15-1.265-.467-2.41-1.485-.89-.795-1.49-1.77-1.665-2.07-.177-.3-.019-.462.13-.61.135-.133.3-.349.45-.523.15-.174.2-.3.3-.497.102-.2.05-.374-.025-.524-.075-.15-.688-1.66-.942-2.27-.248-.599-.5-.518-.688-.528-.178-.008-.382-.01-.585-.01-.203 0-.533.076-.812.379-.28.3-1.066 1.045-1.066 2.55 0 1.503 1.092 2.955 1.24 3.155.15.2 2.15 3.286 5.207 4.606.728.314 1.298.5 1.742.64.733.232 1.399.199 1.926.12.589-.089 1.782-.728 2.032-1.432.25-.704.25-1.309.175-1.43-.075-.125-.28-.201-.58-.351z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-1">WhatsApp</h4>
          <p class="text-xs text-gray-400 font-mono select-all">{CONTACT.phone}</p>
        </div>
        <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          {UI.whatsappButton} &rarr;
        </span>
      </a>
    </AnimatedSection>

    <!-- LinkedIn Card -->
    <AnimatedSection client:visible delay={0.45}>
      <a 
        href={`https://${CONTACT.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col items-center text-center gap-4 group h-full justify-between"
        style="will-change: transform, opacity;"
      >
        <div class="p-3.5 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/15 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-base font-bold text-white mb-1">LinkedIn</h4>
          <p class="text-xs text-gray-400 font-mono select-all truncate max-w-[180px]">{CONTACT.linkedin.replace("www.linkedin.com/in/", "")}</p>
        </div>
        <span class="text-xs font-semibold text-sky-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          {UI.linkedinButton} &rarr;
        </span>
      </a>
    </AnimatedSection>
  </div>
</section>
