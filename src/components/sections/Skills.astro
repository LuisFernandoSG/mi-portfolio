---
// src/components/sections/Skills.astro
import { AnimatedSection } from "../../components/ui/AnimatedSection.tsx";
import Badge from "../ui/Badge.astro";
import type { CONTENT } from "../../data/portfolioData";

interface Props {
    content: typeof CONTENT['es']; 
}

const { content } = Astro.props;

const SKILLS = content.SKILLS;
const UI = content.UI;
---

<section id="habilidades" class="max-w-4xl mx-auto px-6 py-20 md:py-28">
  <AnimatedSection client:visible>
    <div class="flex items-center gap-3 mb-10">
      <span class="h-8 w-1 bg-sky-500 rounded-full"></span>
      <h3 class="text-3xl font-bold tracking-tight text-white">{UI.skillsTitle}</h3>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Dev Skills -->
      <div class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h4 class="text-lg font-bold text-white">{UI.devTitle}</h4>
        </div>
        <div class="flex flex-wrap gap-2">
          {SKILLS.dev.map((skill) => <Badge>{skill}</Badge>)}
        </div>
      </div>

      <!-- Database Skills -->
      <div class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4" />
            </svg>
          </div>
          <h4 class="text-lg font-bold text-white">{UI.dbTitle}</h4>
        </div>
        <div class="flex flex-wrap gap-2">
          {SKILLS.databases.map((skill) => <Badge>{skill}</Badge>)}
        </div>
      </div>

      <!-- BI Skills -->
      <div class="glass-card glass-card-hover rounded-2xl p-6 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/15">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z" />
            </svg>
          </div>
          <h4 class="text-lg font-bold text-white">{UI.biTitle}</h4>
        </div>
        <div class="flex flex-wrap gap-2">
          {SKILLS.bi.map((skill) => <Badge>{skill}</Badge>)}
        </div>
      </div>
    </div>
  </AnimatedSection>
</section>