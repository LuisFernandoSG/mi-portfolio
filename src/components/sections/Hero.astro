---
// src/components/sections/Hero.astro
// 1. Importar el tipo Content
import type { CONTENT } from "../../data/portfolioData";
import { AnimatedSection } from "../../components/ui/AnimatedSection.tsx";

// 2. Definir la prop que esperamos recibir
interface Props {
  content: (typeof CONTENT)["es"]; // Usamos typeof para inferir la estructura
}

const { content } = Astro.props;

// 3. Usar 'content' en lugar de importaciones directas
const PROFILE = content.PROFILE;
const CONTACT = content.CONTACT;
const UI = content.UI;
---

<section
  id="inicio"
  class="max-w-5xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28"
>
  <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
    <!-- Column 1: Info -->
    <div>
      <AnimatedSection client:visible>
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-semibold mb-6 backdrop-blur-md"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-500 pulse-green"></span>
          {
            content.UI.homeLink === "Inicio"
              ? "Disponible para nuevos proyectos"
              : "Available for new projects"
          }
        </div>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.15}>
        <h1
          class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-4"
        >
          {PROFILE.Greeting}
          <span class="titulo-degradado block sm:inline">{PROFILE.name}</span>
        </h1>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.3}>
        <h2 class="text-2xl md:text-3xl font-semibold text-gray-300 mb-6">
          {PROFILE.title}
        </h2>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.45}>
        <p
          class="text-base md:text-lg text-gray-400 leading-relaxed mb-8 max-w-xl"
        >
          {PROFILE.summary}
        </p>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.6}>
        <div class="flex flex-col sm:flex-row gap-3.5">
          <!-- <a
            href={`mailto:${CONTACT.email}`}
            class="bg-gradient-to-r from-sky-500 to-indigo-600 hover:shadow-lg hover:shadow-sky-500/20 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 text-center hover:scale-[1.02] transform flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {UI.contactButton}
          </a>
          <a
            href={`https://${CONTACT.linkedin}`}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-slate-900 border border-white/10 hover:bg-slate-800 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 text-center hover:scale-[1.02] transform flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            {UI.linkedinButton}
          </a> -->
          {
            UI.resumeButton && (
              <a
                href={CONTACT.resume}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-emerald-600/90 hover:bg-emerald-600 hover:shadow-lg hover:shadow-emerald-600/20 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 text-center hover:scale-[1.02] transform flex items-center justify-center gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
                {UI.resumeButton}
              </a>
            )
          }
        </div>
      </AnimatedSection>
    </div>

    <!-- Column 2: Avatar -->
    <div class="flex justify-center">
      <AnimatedSection client:visible delay={0.3}>
        <div
          id="avatar-container"
          class="relative flex justify-center items-center cursor-grab active:cursor-grabbing select-none"
          style="perspective: 1000px;"
        >
          <!-- Floating animated wrapper -->
          <div class="floating-card-wrapper">
            <!-- Ambient lighting blur behind profile -->
            <div
              id="avatar-glow"
              class="absolute inset-0 bg-gradient-to-tr from-sky-400 to-indigo-600 rounded-3xl blur-[40px] opacity-35 transition-all duration-300 ease-out"
              style="transform: translateZ(-20px);"
            >
            </div>
            <!-- Profile image container (starts tilted at a 3D angle) -->
            <div
              id="avatar-card"
              class="relative p-2.5 rounded-[2rem] bg-slate-900 border border-white/10 shadow-2xl transition-all duration-300 ease-out"
              style="transform-style: preserve-3d; transform: rotateX(6deg) rotateY(-10deg); will-change: transform;"
            >
              <img
                src="/img/profile.png"
                alt={PROFILE.name}
                class="w-60 h-60 md:w-72 md:h-72 object-cover rounded-[1.6rem] shadow-inner bg-gradient-to-b from-slate-800 to-slate-950 transition-all duration-300 ease-out"
                style="transform: translateZ(40px); transform-style: preserve-3d; will-change: transform;"
              />
            </div>
          </div>
        </div>
      </AnimatedSection>
    </div>
  </div>
</section>

<style>
  @keyframes float-anim {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  .floating-card-wrapper {
    animation: float-anim 5s ease-in-out infinite;
    transform-style: preserve-3d;
    position: relative;
    will-change: transform;
  }
</style>

<script>
  const container = document.getElementById("avatar-container");
  const card = document.getElementById("avatar-card");
  const glow = document.getElementById("avatar-glow");

  // Baseline angle when mouse is not hovering (always 3D look)
  const baseRotateX = 6;
  const baseRotateY = -10;

  if (container && card) {
    let ticking = false;

    container.addEventListener("mousemove", (e) => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left; // Mouse X relative to container
          const y = e.clientY - rect.top; // Mouse Y relative to container

          const centerX = rect.width / 2;
          const centerY = rect.height / 2;

          // Calculate rotation (Max: ~18 degrees)
          const rotateX = ((centerY - y) / centerY) * 18;
          const rotateY = ((x - centerX) / centerX) * 18;

          card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          if (glow) {
            // Move the glow opposite to tilt
            const glowX = ((centerX - x) / centerX) * 15;
            const glowY = ((centerY - y) / centerY) * 15;
            glow.style.transform = `translate3d(${glowX}px, ${glowY}px, -25px) scale(0.95)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    });

    container.addEventListener("mouseleave", () => {
      // Smooth reset back to baseline tilt angle instead of flat 0
      card.style.transform = `rotateX(${baseRotateX}deg) rotateY(${baseRotateY}deg) scale3d(1, 1, 1)`;
      if (glow) {
        glow.style.transform = `translate3d(0px, 0px, -20px) scale(1)`;
      }
    });
  }
</script>
