---
// src/components/Footer.astro
import type { CONTENT } from "../data/portfolioData";

interface Props {
  content: (typeof CONTENT)["es"];
}

const { content } = Astro.props;
const CONTACT = content.CONTACT;
const PROFILE = content.PROFILE;

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/5 bg-slate-950/40 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex flex-col items-center md:items-start gap-1">
      <div class="text-lg font-bold text-white tracking-tight flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-sky-500"></span>
        {PROFILE.name}
      </div>
      <p class="text-sm text-gray-500 font-medium">
        &copy; {year} — Todos los derechos reservados / All rights reserved.
      </p>
    </div>

    <div class="flex items-center gap-6">
      <a 
        href={`mailto:${CONTACT.email}`} 
        class="text-sm text-gray-400 hover:text-sky-400 transition-colors"
        aria-label="Email"
      >
        Email
      </a>
      <a 
        href={`https://${CONTACT.linkedin}`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-sm text-gray-400 hover:text-sky-400 transition-colors"
        aria-label="LinkedIn"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
